---
import type { CollectionEntry } from 'astro:content'
import { getMonthName, withBase } from '$/utils'

interface Props {
    post: CollectionEntry<'blog'>
}

const { post: { data: post, slug } } = Astro.props
---
<div class="post-preview">
    <div class="post-preview__date">
        <span class="post-preview__date__day">{ String(new Date(post.date).getDate()).padStart(2, '0') }</span>
        <span class="post-preview__date__month-n-year">{ `${getMonthName(post.date)} ${new Date(post.date).getFullYear()}` }</span>
    </div>
    <div class="post-preview__body">
        <h4 class="post-preview__title">
            <a href={withBase(`blog/${slug}`)} title={post.title}>{post.title}</a>
        </h4>
        <p class="post-preview__desc">
            {post.description}
        </p>
    </div>
</div>
<style>
    .post-preview {
        display: flex;
        gap: 1.2em;
        align-items: flex-start;
    }
    .post-preview__date {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 3.5em;
        padding-top: 0.1em;
        border-right: 1px solid var(--line-soft);
        padding-right: 1em;
    }
    .post-preview__date__day {
        font-size: 1.5rem;
        font-weight: 600;
        font-family: "Fira Code", monospace;
        color: var(--ink-darkest);
        line-height: 1;
    }
    .post-preview__date__month-n-year {
        font-size: 0.72rem;
        color: var(--ink-faint);
        margin-top: 0.2em;
        letter-spacing: 0.03em;
    }
    .post-preview__body {
        flex: 1;
        min-width: 0;
    }
    .post-preview__title {
        font-size: 1.05rem;
        font-weight: 600;
        margin-bottom: 0.3em;
        line-height: 1.4;
    }
    .post-preview__title a {
        color: var(--ink-darkest);
    }
    .post-preview__title a:hover {
        color: var(--ink);
    }
    .post-preview__desc {
        font-size: 0.875rem;
        color: var(--ink-soft);
        line-height: 1.5;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }
</style>
